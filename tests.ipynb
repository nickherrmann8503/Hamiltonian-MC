    "\"\"\"Xns_flat = Xns.reshape(-1, Xns.shape[-1])   # (600, 6)\n",
    "n = Xns_flat.shape[1]\n",
    "labels = [f\"p{i}\" for i in range(n)]        # replace with your parameter names\n",
    "\n",
    "fig, axes = plt.subplots(n, n, figsize=(2*n, 2*n), sharex=\"col\")\n",
    "\n",
    "for i in range(n):\n",
    "    for j in range(n):\n",
    "        ax = axes[i, j]\n",
    "        if j > i:\n",
    "            ax.axis(\"off\")\n",
    "            continue\n",
    "\n",
    "        if i == j:\n",
    "            ax.hist(Xns_flat[:, i], bins=30)\n",
    "            ax.set_yticks([])\n",
    "        else:\n",
    "            ax.scatter(Xns_flat[:, j], Xns_flat[:, i], s=8, alpha=0.5)\n",
    "            # share y within each row, except the diagonal panel\n",
    "            if j > 0:\n",
    "                ax.sharey(axes[i, 0])\n",
    "\n",
    "        # tick labels only on the outer edge\n",
    "        if i < n - 1:\n",
    "            ax.tick_params(labelbottom=False)\n",
    "        else:\n",
    "            ax.set_xlabel(labels[j])\n",
    "        if j > 0:\n",
    "            ax.tick_params(labelleft=False)\n",
    "        elif i > 0:\n",
    "            ax.set_ylabel(labels[i])\n",
    "\n",
    "fig.subplots_adjust(hspace=0.05, wspace=0.05)\n",
    "plt.show()\"\"\""
