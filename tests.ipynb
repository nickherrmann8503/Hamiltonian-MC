    "def leapfrog(x, p, dt, L, mass_inv, grad_logp):\n",
    "\n",
    "    x = x.copy()\n",
    "    p = p.copy()\n",
    "\n",
    "    # Initial half-step\n",
    "    p += 0.5 * dt * grad_logp(x)\n",
    "\n",
    "    for i in range(L):\n",
    "\n",
    "        # Full position step\n",
    "        x += dt * (p @ mass_inv)\n",
    "\n",
    "        # Full momentum step, except at the end\n",
    "        if i != L - 1:\n",
    "            p += dt * grad_logp(x)\n",
    "\n",
    "    # Final half-step\n",
    "    p += 0.5 * dt * grad_logp(x)\n",
    "\n",
    "    return x, p\n",
    "\n",
    "def dchain(x_0, N, dt, L, mass_matrix,\n",
    "           method=\"gaussian\", random_seed=None, rho=0):\n",
    "\n",
    "    rng = np.random.default_rng(random_seed)\n",
    "\n",
    "    nchains, d = x_0.shape\n",
    "\n",
    "    if method == \"gaussian\":\n",
    "\n",
    "        means = np.zeros(d)\n",
    "\n",
    "        indices = np.arange(d)\n",
    "\n",
    "        Sigma = rho ** np.abs(\n",
    "            indices[:, None] - indices[None, :]\n",
    "        )\n",
    "\n",
    "        Sigma_inv = np.linalg.inv(Sigma)\n",
    "\n",
    "        def logp(x):\n",
    "            dx = x - means\n",
    "            return -0.5 * np.sum(\n",
    "                (dx @ Sigma_inv) * dx, axis=-1\n",
    "            )\n",
    "\n",
    "        def grad_logp(x):\n",
    "            return -(x - means) @ Sigma_inv\n",
    "\n",
    "    else:\n",
    "        raise ValueError(\"Unsupported method\")\n",
    "\n",
    "    # Precompute mass matrix operations\n",
    "    mass_inv = np.linalg.inv(mass_matrix)\n",
    "    mass_chol = np.linalg.cholesky(mass_matrix)\n",
    "\n",
    "    def kinetic_energy(p):\n",
    "        return 0.5 * np.sum(\n",
    "            (p @ mass_inv) * p, axis=-1\n",
    "        )\n",
    "\n",
    "    X = np.zeros((N, nchains, d))\n",
    "    X[0] = x_0\n",
    "\n",
    "    for n in range(N - 1):\n",
    "\n",
    "        # Sample momentum\n",
    "        p_0 = rng.standard_normal(\n",
    "            (nchains, d)\n",
    "        ) @ mass_chol.T\n",
    "\n",
    "        # Leapfrog integration\n",
    "        x_Ldt, p_Ldt = leapfrog(\n",
    "            X[n], p_0, dt, L, mass_inv, grad_logp\n",
    "        )\n",
    "\n",
    "        # Hamiltonians\n",
    "        H_old = -logp(X[n]) + kinetic_energy(p_0)\n",
    "        H_new = -logp(x_Ldt) + kinetic_energy(p_Ldt)\n",
    "\n",
    "        # Metropolis acceptance in log space\n",
    "        log_alpha = np.minimum(0, H_old - H_new)\n",
    "\n",
    "        accept = np.log(\n",
    "            rng.random(nchains)\n",
    "        ) < log_alpha\n",
    "\n",
    "        X[n+1] = np.where(\n",
    "            accept[:, None], x_Ldt, X[n]\n",
    "        )\n",
    "\n",
    "    return X"
   ]
