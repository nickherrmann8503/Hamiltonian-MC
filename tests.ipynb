    "def leapfrog_gauss(x,p,dt,L,mass_matrix,grad_logp):\n",
    "    ps = np.zeros((L+1))\n",
    "    xs = np.zeros((L+1))\n",
    "    \n",
    "    for i in range(L):\n",
    "        p_half = p-0.5 * dt * grad_logp(x)#np.gradient(potential_energy(xs[i]))\n",
    "        x = x + dt / mass_matrix * p_half\n",
    "        p = p_half - 0.5 * dt * grad_logp(x)\n",
    "    return x,p\n",
    "\n",
    "def dchain(x_0,N,dt,L,mass_matrix,method = \"gaussian\",random_seed = None, rho = 0):\n",
    "    #getting method\n",
    "    if method == \"gaussian\":\n",
    "        print(\"Gaussian sampling\")\n",
    "        mu = 0\n",
    "        d = x_0[0].size\n",
    "        means = np.zeros(d)\n",
    "        Sigma = np.zeros((d,d))\n",
    "        for i in range(d):\n",
    "            for j in range(d):\n",
    "                means[i] = mu\n",
    "                Sigma[i,j] = rho ** (np.abs(i-j))\n",
    "        Sigma_inv = np.linalg.inv(Sigma)\n",
    "        logp = lambda x: - 0.5 * (x - means).T @ Sigma_inv @ (x - means)\n",
    "        grad_logp = lambda x: - Sigma_inv @ (x - means)\n",
    "        leapfrog_used = leapfrog_gauss(grad_logp = grad_logp)\n",
    "    elif method == \"neal\":\n",
    "        print(\"Neal's funnel sampling\")\n",
    "        logp = log_neal_funnel\n",
    "        is_log = True\n",
    "        leapfrog_used = leapfrog_d\n",
    "    else:\n",
    "        print(\"invalid method\")\n",
    "        return \"err\"\n",
    "\n",
    "    # getting/creating random state\n",
    "    if random_seed == None:\n",
    "        rng = np.random.default_rng()\n",
    "    else:\n",
    "        rng = np.random.default_rng(random_seed)\n",
    "    #needs x_0 in shape (N_chains,d)\n",
    "\n",
    "    X = np.zeros((N,len(x_0),len(x_0[0])))\n",
    "    X[0] = x_0\n",
    "    #print(x_0.shape)\n",
    "\n",
    "    for n in range(N-1):\n",
    "        p_0 = np.squeeze(rng.multivariate_normal(np.zeros(d), mass_matrix, size=len(x_0)))\n",
    "        #print(\"p:\",p_0)\n",
    "        x_Ldt,p_Ldt = leapfrog_used(X[n],p_0,dt,L,mass_matrix,logp)\n",
    "        al = alpha_d(X[n], x_Ldt, p_0, p_Ldt, mass_matrix,logp)\n",
    "        accept = rng.random(len(al)) < al                # (20,) booleans\n",
    "        X[n+1] = np.where(accept[:, None], x_Ldt, X[n])\n",
    "        #print(\"Xn:\",X[n],n)\n",
    "\n",
    "    return X\n",
    "\n",
    "def KL_div(hist, hist2, eps=1e-10):\n",
    "    p = hist + eps\n",
    "    q = hist2 + eps\n",
    "    p = p / p.sum(axis=1, keepdims=True)   # normalize over bins, per dimension\n",
    "    q = q / q.sum(axis=1, keepdims=True)\n",
    "    return np.sum(p * np.log(p / q), axis=1)   # shape (d,)\n",
    "\n",
    "def KL_comparison(Xns1,Xns2):\n",
    "    # find shared histogram bins\n",
    "    hi = np.max([np.max(Xns1),np.max(Xns2)])\n",
    "    lo = np.min([np.min(Xns1),np.min(Xns2)])\n",
    "    edges = np.linspace(lo, hi, nbins + 1)\n",
    "\n",
    "    # create histogram form chain 1\n",
    "    Xns_flat1 = Xns1.reshape(-1, Xns1.shape[-1])\n",
    "    hist1 = []\n",
    "    for i in range(Xns_flat1[0,:].size):\n",
    "        histogram_data1, _ = np.histogram(Xns_flat1[:,i],bins = edges)\n",
    "        hist1.append(histogram_data1)\n",
    "\n",
    "    hist1 = np.asarray(hist1) # all bin entries for each dimension\n",
    "\n",
    "    # create histogram from chain 2\n",
    "    Xns_flat2 = Xns2.reshape(-1, Xns2.shape[-1])\n",
    "    hist2 = []\n",
    "    for i in range(Xns_flat2[0,:].size):\n",
    "        histogram_data2, _ = np.histogram(Xns_flat2[:,i],bins = edges)\n",
    "        hist2.append(histogram_data2)\n",
    "\n",
    "    hist2 = np.asarray(hist2) # all bin entries for each dimension\n",
    "\n",
    "    return KL_div(hist1,hist2), hist1, hist2\n"
   ]
