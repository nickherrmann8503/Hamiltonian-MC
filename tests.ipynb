    "N_steps = 1000\n",
    "print(\"the inverse mass matrix is:\",np.linalg.inv(M))\n",
    "\n",
    "p_start = np.random.normal(0,1)\n",
    "p_start = np.random.default_rng().multivariate_normal([0,0], M, size=1)\n",
    "\n",
    "#now computes alll chains at once\n",
    "start_time = time()\n",
    "X0s = [[random()*100,random()*100] for i in range(nchains)]\n",
    "\n",
    "#NAIVE NUTS\n",
    "logp = lambda x: np.log(gaussian_ND(x,means,Sigma))\n",
    "start_time = time()\n",
    "Xns = np.array(NAIVE_NUTS(np.array(X0s),dt,logp,N_steps,np.eye(2)))\n",
    "print((time()-start_time)/60)\n",
    "for i in range(nchains):\n",
    "    plt.plot(Xns[i,:,0],Xns[i,:,1])\n",
    "\n",
    "\n",
    "#Grid\n",
    "x = np.linspace(0,100,100)\n",
    "y = np.linspace(0,100,100)\n",
    "X,Y = np.meshgrid(x,y)\n",
    "pos = np.dstack((X,Y))\n",
    "\n",
    "Z = multivariate_normal(means,Sigma).pdf(pos)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "cf = plt.contourf(X,Y,Z,levels=10,cmap=\"viridis\")\n",
    "#plt.contour(X,Y,Z,levels=8,colors=\"white\",linewidths = 0.5)\n",
    "plt.colorbar(cf)\n",
    "plt.show()\n",
    "\n",
    "for Xn in Xns:\n",
    "    plt.plot(Xn[:,0])\n",
    "    plt.plot(Xn[:,1])\n",
    "plt.show()\n",
    "print(np.mean(Xn[:,0]),np.mean(Xn[:,1]))\n"
   ]
